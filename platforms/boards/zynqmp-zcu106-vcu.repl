using "./zynqmp-zcu104.repl"

virtio: Storage.VirtIOBlockDevice @ sysbus 0xfe400000 { IRQ->apuGic@32 }

allegro: Video.Allegro_E310 @ sysbus 0xa0100000
    -> apuGic @ 89

sysbus:
    init add:
        // Fixed VCU core clock configuration (PLLs are not modelled)
        Tag <0xA0140000 4> "VCU_UNK_00" 0x00000000
        Tag <0xA0140004 4> "VCU_UNK_04" 0x005DB2CB
        Tag <0xA0140008 4> "VCU_UNK_08" 0x000016CB
        Tag <0xA014000C 4> "VCU_UNK_0C" 0x005DB2CB
        Tag <0xA0140010 4> "VCU_UNK_10" 0x000016CB
        Tag <0xA0140014 4> "VCU_UNK_14" 0x00000002
        Tag <0xA0140018 12> "VCU_UNK_18" 0x00000000
        Tag <0xA0140024 4> "VCU_PLL_CTRL" 0x00015500
        Tag <0xA0140028 4> "VCU_UNK_28" 0x7E4B0C82
        Tag <0xA014002C 4> "VCU_UNK_2C" 0x00000000
        Tag <0xA0140030 4> "VCU_UNK_30" 0x00001021
        Tag <0xA0140034 4> "VCU_UNK_34" 0x00001031
        Tag <0xA0140038 4> "VCU_UNK_38" 0x00001021
        Tag <0xA014003C 4> "VCU_UNK_3C" 0x00001031
        Tag <0xA0140040 4> "VCU_UNK_40" 0x0000F000
        Tag <0xA0140044 12> "VCU_UNK_44" 0x00000000
        Tag <0xA0140050 4> "VCU_UNK_50" 0x00BB3BB3
        Tag <0xA0140054 4> "VCU_UNK_54" 0x00BB3BB3
        Tag <0xA0140058 4> "VCU_UNK_58" 0x00002222
        Tag <0xA014005C 4> "VCU_UNK_5C" 0x00002222
        Tag <0xA0140060 4> "VCU_UNK_60" 0x00000009
        Tag <0xA0140064 16> "VCU_UNK_64" 0x00000000
        Tag <0xA0140074 4> "VCU_UNK_74" 0x000FFFFF
        Tag <0xA0140078 24> "VCU_UNK_78" 0x00000000
        Tag <0xA0140090 4> "VCU_UNK_90" 0x00000001
        Tag <0xA0140094 108> "VCU_UNK_94" 0x00000000

        // VCU LogiCORE wrapper
        Tag <0xA0141000 4> "VCU_ECODER_ENABLE" 0x00000001
        Tag <0xA0141004 4> "VCU_DECODER_ENABLE" 0x00000000 // decoder is not yet implemented
        Tag <0xA0141008 4> "VCU_MEMORY_DEPTH" 0x0000DE00
        Tag <0xA014100C 4> "VCU_ENC_COLOR_DEPTH" 0x00000001
        Tag <0xA0141010 4> "VCU_ENC_VERTICAL_RANGE" 0x00000001
        Tag <0xA0141014 4> "VCU_ENC_FRAME_SIZE_X" 0x00001000
        Tag <0xA0141018 4> "VCU_ENC_FRAME_SIZE_Y" 0x00000870
        Tag <0xA014101C 4> "VCU_ENC_COLOR_FORMAT" 0x00000001
        Tag <0xA0141020 4> "VCU_ENC_FPS" 0x0000003C
        Tag <0xA0141024 4> "VCU_MCU_CLK" 0x000001BC
        Tag <0xA0141028 4> "VCU_CORE_CLK" 0x000002C8
        Tag <0xA014102C 4> "VCU_PLL_BYPASS" 0x00000000
        Tag <0xA0141030 4> "VCU_ENC_CLK" 0x00000000
        Tag <0xA0141034 4> "VCU_PLL_CLK" 0x00000021
        Tag <0xA0141038 4> "VCU_ENC_VIDEO_STANDARD" 0x00000000
        Tag <0xA014103C 4> "VCU_STATUS" 0x0000000E
        Tag <0xA0141040 4> "VCU_AXI_ENC_CLK" 0x00000000
        Tag <0xA0141044 4> "VCU_AXI_DEC_CLK" 0x00000000
        Tag <0xA0141048 4> "VCU_AXI_MCU_CLK" 0x0000014D
        Tag <0xA014104C 4> "VCU_DEC_VIDEO_STANDARD" 0x00000000
        Tag <0xA0141050 4> "VCU_DEC_FRAME_SIZE_X" 0x00001000
        Tag <0xA0141054 4> "VCU_DEC_FRAME_SIZE_Y" 0x00000870
        Tag <0xA0141058 4> "VCU_DEC_FPS" 0x0000003C
        Tag <0xA014105C 4> "VCU_BUFFER_B_FRAME" 0x00000001
        Tag <0xA0141060 4> "VCU_WPP_EN" 0x00000000
        Tag <0xA0141064 4> "VCU_PLL_CLK_DEC" 0x00000020
        Tag <0xA0141068 4> "VCU_UNK_68" 0x00000002
        Tag <0xA014106C 4> "VCU_UNK_6C" 0x00000004
        Tag <0xA0141070 4> "VCU_UNK_70" 0x00000011
        Tag <0xA0141074 4> "VCU_GASKET_INIT" 0x00000002
