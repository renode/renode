        Tag <0x2980000 0x1000> "lpuart3"
        Tag <0x2990000 0x1000> "lpuart4"
        Tag <0x29a0000 0x1000> "lpuart5"
        Tag <0x29d0000 0x10000> "ftm_alarm0"
        Tag <0x2ad0000 0x10000> "wdog0"
        Tag <0x2b00000 0x10000> "sys-counter"
        Tag <0x2c00000 0x10000> "edma0"
        Tag <0x2c10000 0x10000> "edma0"
        Tag <0x2c20000 0x10000> "edma0"
        Tag <0x2f00000 0x10000> "usb0"
        Tag <0x3000000 0x10000> "usb1"
        Tag <0x3100000 0x10000> "usb2"
        Tag <0x3200000 0x10000> "sata"
