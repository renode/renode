        Tag <0x1a00000 0xfe000> "fman0 / muram@0 / fman0_oh_0x2 / fman0_oh_0x3 / fman0_oh_0x4 / fman0_oh_0x5 / fman0_oh_0x6 / fman0_oh_0x7 / fman0_rx_0x08 / fman0_rx_0x09 / fman0_rx_0x0a / fman0_rx_0x0b / fman0_rx_0x0c / fman0_rx_0x0d / fman0_rx_0x10 / fman0_tx_0x28 / fman0_tx_0x29 / fman0_tx_0x2a / fman0_tx_0x2b / fman0_tx_0x2c / fman0_tx_0x2d / fman0_tx_0x30 / enet0 / mdio@e1000 / enet1 / mdio@e3000 / enet2 / mdio@e5000 / enet3 / mdio@e7000 / enet4 / mdio@e9000 / enet5 / mdio@eb000 / enet6 / mdio@f1000 / mdio0 / xmdio0"
        Tag <0x1afe000 0x1000> "ptp_timer0"
        Tag <0x1e80000 0x1000> "sfp"
        Tag <0x1ee0000 0x1000> "dcfg"
        Tag <0x1ee1000 0x1000> "clockgen"
        Tag <0x1ee2140 0x4> "rcpm"
        Tag <0x1f00000 0x10000> "tmu"
