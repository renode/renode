        Tag <0x3410000 0x10000> "pcie1"
        Tag <0x3500000 0x10000> "pcie2"
        Tag <0x3510000 0x10000> "pcie2"
        Tag <0x3600000 0x10000> "pcie3"
        Tag <0x3610000 0x10000> "pcie3"
