dcfg: Python.PythonPeripheral @ sysbus 0x01EE0000
    size: 0x1000
    initable: true
    script: "request.Value = 0x1100008f"
    
clockgen: Python.PythonPeripheral @ sysbus 0x01EE1000
    size: 0x1000
    script: '''
if request.IsRead:
    offset = request.Offset

    if offset == 0x800 or offset == 0x820 or offset == 0xc00:
        request.Value = 0x20000000
    elif offset == 0x010:
        request.Value = 0x00000010
    elif offset == 0x030:
        request.Value = 0x00000008
    else:
        request.Value = 0x00000000
    '''
 
secure_boot_rom: Memory.MappedMemory @ sysbus 0x0
    size: 0x100000

ocram1: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000

ocram2: Memory.MappedMemory @ sysbus 0x10010000
    size: 0x10000

flash: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x8000000

memory0: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x80000000

// autogenerated

cpu0: CPU.ARMv8A @ sysbus
    cpuType: "cortex-a53"
    cpuId: 0
    genericInterruptController: gic
/*    
cpu1: CPU.ARMv8A @ sysbus
    cpuType: "cortex-a53"
    cpuId: 1
    genericInterruptController: gic

cpu2: CPU.ARMv8A @ sysbus
    cpuType: "cortex-a53"
    cpuId: 2
    genericInterruptController: gic

cpu3: CPU.ARMv8A @ sysbus
    cpuType: "cortex-a53"
    cpuId: 3
    genericInterruptController: gic
*/        
gic: IRQControllers.ARM_GenericInterruptController @ {
        sysbus new Bus.BusMultiRegistration { address: 0x1410000; size: 0x1000; region: "distributor" };
        sysbus new Bus.BusMultiRegistration { address: 0x1420000; size: 0x2000; region: "cpuInterface" };
        sysbus new Bus.BusMultiRegistration { address: 0x1401000; size: 0x1000; region: "distributor" }
    }
    architectureVersion: IRQControllers.ARM_GenericInterruptControllerVersion.GICv2
//0 - 1000 is reserved


duart0: UART.NS16550 @ sysbus 0x21c0500
    wideRegisters: true
    ->gic@54

duart1: UART.NS16550 @ sysbus 0x21c0600
    wideRegisters: true
    ->gic@54

duart2: UART.NS16550 @ sysbus 0x21d0500
    wideRegisters: true
    ->gic@55

duart3: UART.NS16550 @ sysbus 0x21d0600
    wideRegisters: true
    ->gic@55

i2c0: Python.PythonPeripheral @ sysbus 0x2180000
    size: 0x10000
    initable: true
    filename: "scripts/pydev/flipflop.py"

timer0: Timers.ARM_GenericTimer @ cpu0
    frequency: 25000000
    EL3PhysicalTimerIRQ -> gic#0@26
    EL1PhysicalTimerIRQ -> gic#0@30
    EL1VirtualTimerIRQ -> gic#0@27
    NonSecureEL2PhysicalTimerIRQ -> gic#0@29
/*
timer1: Timers.ARM_GenericTimer @ cpu1
    frequency: 25000000
    EL3PhysicalTimerIRQ -> gic#1@26
    EL1PhysicalTimerIRQ -> gic#1@30
    EL1VirtualTimerIRQ -> gic#1@27
    NonSecureEL2PhysicalTimerIRQ -> gic#1@29
    
timer2: Timers.ARM_GenericTimer @ cpu2
    frequency: 25000000
    EL3PhysicalTimerIRQ -> gic#2@26
    EL1PhysicalTimerIRQ -> gic#2@30
    EL1VirtualTimerIRQ -> gic#2@27
    NonSecureEL2PhysicalTimerIRQ -> gic#2@29
    
timer3: Timers.ARM_GenericTimer @ cpu3
    frequency: 25000000
    EL3PhysicalTimerIRQ -> gic#3@26
    EL1PhysicalTimerIRQ -> gic#3@30
    EL1VirtualTimerIRQ -> gic#3@27
    NonSecureEL2PhysicalTimerIRQ -> gic#3@29
    
*/

// fsl,ls1043a overlay

//Real-time clock
rtc: Timers.PL031 @ sysbus 0x29d0000
    -> gic@2

dspi0: SPI.LS1043SPI @ sysbus 0x2100000
    ->gic@64

sysbus:
    init add:
        Tag <0x43100e0 0x4> "TMU CSR" 0x280
