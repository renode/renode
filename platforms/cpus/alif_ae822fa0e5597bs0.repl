    0->nvic0@171
    1->nvic0@172
    2->nvic0@173
    3->nvic0@174
    4->nvic0@175
    5->nvic0@176
    6->nvic0@177
    7->nvic0@178

i2c0: I2C.DesignWare_APB_I2C @ sysbus 0x49010000
    -> nvic0@132

i2c1: I2C.DesignWare_APB_I2C @ sysbus 0x49011000
    -> nvic0@133

i2c2: I2C.DesignWare_APB_I2C @ sysbus 0x49012000
    -> nvic0@134

i2c3: I2C.DesignWare_APB_I2C @ sysbus 0x49013000
    -> nvic0@135

uart0: UART.NS16550 @ sysbus 0x49018000
    wideRegisters: true
    -> nvic0@124

uart1: UART.NS16550 @ sysbus 0x49019000
    wideRegisters: true
    -> nvic0@125

uart2: UART.NS16550 @ sysbus 0x4901a000
    wideRegisters: true
    -> nvic0@126

uart3: UART.NS16550 @ sysbus 0x4901b000
    wideRegisters: true
    -> nvic0@127

uart4: UART.NS16550 @ sysbus 0x4901c000
    wideRegisters: true
    -> nvic0@128

uart5: UART.NS16550 @ sysbus 0x4901d000
    wideRegisters: true
    -> nvic0@129

uart6: UART.NS16550 @ sysbus 0x4901e000
    wideRegisters: true
    -> nvic0@130

uart7: UART.NS16550 @ sysbus 0x4901f000
    wideRegisters: true
    -> nvic0@131

fdcan: CAN.CAST_CANCTRL @ {
        sysbus 0x49036000;
        sysbus new Bus.BusMultiRegistration { address: 0x49037000; size: 0x1000; region: "counter" }
    }
    IRQ -> nvic0@104

dwt: Miscellaneous.DWT @ sysbus 0xe0001000
    frequency: 160000000

sysbus:
    init add:
        Tag <0x1a603000 0x1000> "pinctrl"
        Tag <0x42007000 0x1000> "pinctrl"
        Tag <0x4902f000 0xbc> "clockctrl"
        Tag <0x4903f000 0xb0> "clockctrl"
        Tag <0x1a604000 0x48> "clockctrl"
        Tag <0x1a602000 0x2c> "clockctrl"
        Tag <0x43007000 0x28> "clockctrl"
        Tag <0x1a609000 0x14> "clockctrl"
        Tag <0x400f0000 0x14> "clockctrl"
