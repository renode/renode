// This platform description models the RTSS-HE core and peripherals.

itcm: Memory.MappedMemory @ sysbus 0x0
    size: 0x40000

sram0: Memory.MappedMemory @ sysbus 0x2000000
    size: 0x400000

sram1: Memory.MappedMemory @ sysbus 0x2400000
    size: 0x400000

dtcm: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

mram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x580000

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 160000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic0

gpio0: GPIOPort.DesignWare_APB_GPIO @ sysbus 0x49000000
    0->nvic0@179
    1->nvic0@180
    2->nvic0@181
    3->nvic0@182
    4->nvic0@183
    5->nvic0@184
    6->nvic0@185
    7->nvic0@186

gpio1: GPIOPort.DesignWare_APB_GPIO @ sysbus 0x49001000
    0->nvic0@187
    1->nvic0@188
    2->nvic0@189
    3->nvic0@190
    4->nvic0@191
    5->nvic0@192
    6->nvic0@193
    7->nvic0@194

gpio2: GPIOPort.DesignWare_APB_GPIO @ sysbus 0x49002000
    0->nvic0@195
    1->nvic0@196
    2->nvic0@197
    3->nvic0@198
    4->nvic0@199
    5->nvic0@200
    6->nvic0@201
    7->nvic0@202

