// STM32G474 (Cortex-M4F, 170 MHz), built from Renode's existing STM32 models.
// Addresses and IRQ numbers: ST's CMSIS device header stm32g474xx.h.  What
// each model covers is noted at it; anything not listed is unmapped.
//
// Models used under another series' name (Renode has no STM32Series.G4):
//   - RCC: STM32L5_RCC.  Its register offsets and the HSE/PLL/SW bits match
//     the G4's; it has no HSION/HSIRDY and no clock tree (SysTick and DWT
//     frequencies are fixed below).
//   - SPI: STM32SPI series L5 (CR2.DS / FRXTH; the G4's SPI register layout).
//   - FDCAN: STM32_FDCAN series L5.  Its fixed message RAM layout (RxFIFO0 at
//     0xB0, Tx buffers at 0x278, 72-byte elements) is the G4's.  TEST / MON /
//     LBCK are not modelled; its kernel clock is fixed at 48 MHz.
//   - ADC1: STM32L5_ADC.  The model's window is 0x400, so it also covers the
//     ADC1/2 common block (CCR at 0x308) and ADC2's address; ADC2 is not
//     modelled separately.
// Stubs: the flash interface (a Python peripheral: ACR keeps what is written,
// SR reads not busy, OPTR a fixed value), PWR, SYSCFG and DBGMCU (tags).

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 170000000
    IRQ -> cpu@0

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 170000000

// Memories: flash 512 KB (G474xE), SRAM1 80 KB + SRAM2 16 KB contiguous,
// CCM SRAM 32 KB at 0x10000000 (its alias at 0x20018000 is not mapped),
// system memory (bootloader, unique ID, calibration values).
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x80000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x18000

ccmsram: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x8000

sysmem: Memory.MappedMemory @ sysbus 0x1FFF0000
    size: 0x8000

rcc: Miscellaneous.STM32L5_RCC @ sysbus 0x40021000

flashController: Python.PythonPeripheral @ sysbus 0x40022000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x00: 0x00000600, 0x14: 0xC0000000, 0x20: 0xFFEFF8AA}
if request.IsWrite:
    if request.Offset in (0x00, 0x14):
        regs[request.Offset] = request.Value
    elif request.Offset == 0x08 and request.Value == 0xCDEF89AB:
        regs[0x14] &= ~0x80000000
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
'''

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000

// GPIO reset values: as Renode's stm32l552.repl (SWD on PA13/PA14, PB3/PB4).
gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0xABFFFFFF
    outputSpeedResetValue: 0x0C000000
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    modeResetValue: 0xFFFFFEBF
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x48000C00, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x48001000, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x48001400, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x48001800, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

// U(S)ARTs: Renode's STM32F7_USART (the CR1/BRR/ISR/RDR/TDR layout the L4/L5/G4
// parts share; stm32l552.repl uses it for its LPUART1 too).
usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 170000000
    IRQ -> nvic@37

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 170000000
    IRQ -> nvic@38

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 170000000
    IRQ -> nvic@39

lpuart1: UART.STM32F7_USART @ sysbus 0x40008000
    frequency: 170000000
    IRQ -> nvic@91

spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.L5
    IRQ -> nvic@35

fdcanRAM: Memory.ArrayMemory @ sysbus 0x4000A400
    size: 0x400

fdcan1: CAN.STM32_FDCAN @ sysbus 0x40006400
    series: STM32Series.L5
    messageRam: fdcanRAM
    Int0 -> nvic@21
    Int1 -> nvic@22

adc1: Analog.STM32L5_ADC @ sysbus 0x50000000
    referenceVoltage: 3.3
    externalEventFrequency: 1000
    IRQ -> nvic@18

// VREFINT, ADC1's internal channel 18.  Its voltage is set from the monitor:
//     sysbus.adc1.vrefint Volts 1.212
vrefint: Analog.ADCChannelSource @ adc1 18

sysbus:
    init:
        Tag <0x40007000 0x400> "PWR"
        Tag <0x40010000 0x30> "SYSCFG"
        Tag <0xE0042000 0x400> "DBGMCU"
