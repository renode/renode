fsmcBank1: Memory.MappedMemory @ sysbus 0xC0000000
    size: 0x10000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

pwr: Miscellaneous.STM32WBA_PWR @ sysbus 0x46020800

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 200000000
    IRQ -> nvic@46

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 200000000
    IRQ -> nvic@47

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 200000000
    IRQ -> nvic@79

lpuart1: UART.STM32F7_USART @ sysbus 0x46002400
    frequency: 200000000
    lowPowerMode: true
    IRQ -> nvic@48

spi1: SPI.STM32WBA_SPI @ sysbus 0x40013000
    IRQ -> nvic@45

spi2: SPI.STM32WBA_SPI @ sysbus 0x40003800
    IRQ -> nvic@75

spi3: SPI.STM32WBA_SPI @ sysbus 0x46002000
    IRQ -> nvic@63

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

exti: IRQControllers.STM32WBA_EXTI @ sysbus 0x46022000
    numberOfOutputLines: 24
    [0-15] -> nvic@[11-26]

adc4: Analog.STM32WBA_ADC @ sysbus 0x46021000
    referenceVoltage: 3.0
    externalEventFrequency: 1000
    -> nvic@65

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>
    modeResetValue: 0xABFFFFFF
    outputSpeedResetValue: 0x08000000
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16
    invertedAFPins: [[0, 1], [1, 1], [3, 14]]
    [0-15] -> exti#0@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    modeResetValue: 0xFFFFFEBF
    outputSpeedResetValue: 0x00000080
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16
    invertedAFPins: [[0, 1], [1, 1], [2, 1], [3, 14], [7, 1], [8, 14], [9, 1]]
    [0-15] -> exti#1@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>
    modeResetValue: 0xFC000000
    numberOfAFs: 16
    [0-15] -> exti#2@[0-15]

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x42020C00, +0x400>
    numberOfAFs: 16
    [0-15] -> exti#3@[0-15]

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>
    numberOfAFs: 16
    [0-15] -> exti#4@[0-15]

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>
    numberOfAFs: 16
    [0-15] -> exti#6@[0-15]

gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x42021C00, +0x400>
    modeResetValue: 0x000000C0
    numberOfAFs: 16
    [0-15] -> exti#7@[0-15]

rom: Memory.MappedMemory @ sysbus 0x1FFF0000
    size: 0x10000

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@43
    ErrorInterrupt -> nvic@44

i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@73
    ErrorInterrupt -> nvic@74

i2c3: I2C.STM32F7_I2C @ sysbus 0x46002800
    EventInterrupt -> nvic@54
    ErrorInterrupt -> nvic@55

i2c4: I2C.STM32F7_I2C @ sysbus 0x40008400
    EventInterrupt -> nvic@77
    ErrorInterrupt -> nvic@78

timer1: Timers.STM32_Timer @ sysbus 0x40012C00
    initialLimit: 0xFFFF
    frequency: 16000000
    BreakInterrupt -> nvic@37
    UpdateInterrupt -> nvic@38
    [TriggerInterrupt, CommutationInterrupt] -> nvic@[39, 39]
    CaptureCompareInterrupt -> nvic@40

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    initialLimit: 0xFFFFFFFF
    frequency: 16000000
    -> nvic@41

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    initialLimit: 0xFFFF
    frequency: 16000000
    -> nvic@42

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    initialLimit: 0xFFFF
    frequency: 16000000
    -> nvic@72

timer16: Timers.STM32_Timer @ sysbus 0x40014400
    initialLimit: 0xFFFF
    frequency: 16000000
    -> nvic@51

timer17: Timers.STM32_Timer @ sysbus 0x40014800
    initialLimit: 0xFFFF
    frequency: 16000000
    -> nvic@52

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000
    windowOption: true
    defaultPrescaler: 0

lptim1: Timers.STM32L0_LpTimer @ sysbus 0x46004400
    frequency: 16000000
    -> nvic@49

lptim2: Timers.STM32L0_LpTimer @ sysbus 0x40009400
    frequency: 16000000
    -> nvic@50

rtc: Timers.STM32F4_RTC @ sysbus 0x46007800

flash_ctrl: MTD.STM32WBA_FlashController @ sysbus 0x40022000
    flash: flash

rcc: Miscellaneous.STM32WBA_RCC @ sysbus 0x46020C00
    nvic: nvic
    lptim1: lptim1
    lptim2: lptim2

gpdma1: DMA.STM32WBA55_GPDMA @ sysbus 0x40020000
    numberOfChannels: 8
    [0-7] -> nvic@[28-35]

sai1: Sound.STM32_SAI @ sysbus 0x40015400
    IRQ -> nvic@56

comp: Analog.STM32_COMP @ sysbus 0x46005400
    IRQ -> nvic@53

vrefbuf: Analog.STM32_VREFBUF @ sysbus 0x46007400

aes: Cryptography.STM32_AES @ sysbus 0x420C0000
    IRQ -> nvic@58

saes: Cryptography.STM32_AES @ sysbus 0x420C0C00
    IRQ -> nvic@28

hash: Cryptography.STM32_HASH @ sysbus 0x420C0400
    IRQ -> nvic@61

pka: Cryptography.STM32_PKA @ sysbus 0x420C2000
    IRQ -> nvic@62

crc: CRC.STM32_CRC @ sysbus 0x40023000
    series: STM32Series.WBA

rng: Miscellaneous.STM32_RNG @ sysbus 0x420C0800
    series: STM32Series.WBA
    IRQ -> nvic@59

usb: USB.STM32_USB_OTG_HS @ sysbus 0x42040000
    IRQ -> nvic@76

wwdg: Timers.STM32_WWDG @ sysbus 0x40002C00
    IRQ -> nvic@0

ramcfg: Miscellaneous.STM32_RAMCFG @ sysbus 0x40026000
    IRQ -> nvic@5

icache: Miscellaneous.STM32_ICACHE @ sysbus 0x40030400
    IRQ -> nvic@64

hsem: Miscellaneous.STM32_HSEM @ sysbus 0x420C1C00
    IRQ -> nvic@68

sbs: Miscellaneous.STM32_SBS @ sysbus 0x46000400

systemInformation: Memory.MappedMemory @ sysbus 0x0BFA0000
    size: 0x1000
    init:
        WriteWord 0x0500 0x0800
        WriteDoubleWord 0x0700 0x12345678
        WriteDoubleWord 0x0704 0x23456789
        WriteDoubleWord 0x0708 0x3456789A
        WriteWord 0x0710 0x0400
        WriteWord 0x0742 0x0540
        WriteWord 0x07A4 0x0665

timer1:
    0 -> gpioPortA#01@01 | gpioPortA#11@01 | gpioPortB#02@01 | gpioPortB#08@01
    1 -> gpioPortA#00@01 | gpioPortA#12@01 | gpioPortB#01@01
    2 -> gpioPortB#00@01 | gpioPortB#04@01 | gpioPortB#09@01
    3 -> gpioPortB#03@01 | gpioPortB#07@01

timer2:
    0 -> gpioPortA#05@01 | gpioPortB#06@01 | gpioPortB#12@01
    1 -> gpioPortA#08@01
    2 -> gpioPortA#07@01
    3 -> gpioPortA#06@01

timer3:
    0 -> gpioPortA#02@02 | gpioPortA#10@02 | gpioPortB#05@02
    1 -> gpioPortA#01@02 | gpioPortA#09@02
    2 -> gpioPortA#00@02 | gpioPortB#14@02
    3 -> gpioPortB#09@02 | gpioPortB#13@02

timer16:
    0 -> gpioPortA#02@14 | gpioPortA#03@14 | gpioPortB#08@14 | gpioPortB#09@14

timer17:
    0 -> gpioPortA#01@14 | gpioPortB#03@14 | gpioPortB#04@14

gpioPortA:
    0 -> timer1@01 | timer3@02
    1 -> timer1@00 | timer3@01 | timer17@00
    2 -> timer3@00 | timer16@00
    3 -> timer16@00
    5 -> timer2@00
    6 -> timer2@03
    7 -> timer2@02
    8 -> timer2@01
    9 -> timer3@01
    10 -> timer3@00
    11 -> timer1@00
    12 -> timer1@01

gpioPortB:
    0 -> timer1@02
    1 -> timer1@01
    2 -> timer1@00
    3 -> timer1@03 | timer17@00
    4 -> timer1@02 | timer17@00
    5 -> timer3@00
    6 -> timer2@00
    7 -> timer1@03
    8 -> timer1@00 | timer16@00
    9 -> timer1@02 | timer3@03 | timer16@00
    12 -> timer2@00
    13 -> timer3@03
    14 -> timer3@02

sysbus:
    init:
        Tag <0xE0001004, 0xE0001008> "DWT_CYCCNT" 100
        Tag <0xE0044000, 0xE0044004> "DBGMCU_IDCODE" 0x10006492
        Tag <0xE0044004, 0xE0044100> "DBGMCU" 0
