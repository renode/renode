{
    "workspacePointer": "${workspaceFolder}",

    "files.watcherExclude": {
        "**/output/**": true,
        "**/bin/**": true,
        "**/obj/**": true,
        "**/packages/**": true,
        "**/CMakeFiles/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/TestResults/**": true,
        "**/.pytest_cache/**": true
    },

    "python.analysis.exclude": [
        "**/output",
        "**/.venv",
        "**/__pycache__",
        "**/bin",
        "**/obj",
        "**/CMakeFiles"
    ]
}
