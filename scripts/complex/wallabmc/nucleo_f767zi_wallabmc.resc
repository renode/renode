$name?="nucleo_f767zi_wallabmc"
$bin?=@https://dl.antmicro.com/projects/renode/zephyr--nucleo_f767zi_wallabmc.elf-s_9924968-2a8abf47fcd5b028fa5dd14d6eb905316820f98c
$repl?=@platforms/boards/nucleo_f767zi.repl

mach create $name
machine LoadPlatformDescription $repl

emulation CreateTap "tap0" "tap"
emulation CreateSwitch "switch"
connector Connect host.tap switch
connector Connect ethernet switch

showAnalyzer usart3

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
    cpu EnableZephyrMode
"""

runMacro $reset
