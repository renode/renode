:name STM32 Renode Reference Board multinode
:description Creates an emulation with two STM32 Renode Reference Boards with
:CAN and Ethernet connections

$name="node1"
i @scripts/single-node/stm32h7_renode_reference_board.resc
$name="node2"
i @scripts/single-node/stm32h7_renode_reference_board.resc

emulation CreateSwitch "switch"
emulation CreateCANHub "canHub"

mach set 0
connector Connect sysbus.ethernet switch
connector Connect sysbus.fdcan1 canHub
mach set 1
connector Connect sysbus.ethernet switch
connector Connect sysbus.fdcan1 canHub
