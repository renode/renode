:name: STM32H7 Renode Reference Board
:description: This script is prepared to run Zephyr on STM32H7 Renode Reference Platform board.

$name?="STM32H7 Renode Reference Platform"
mach create $name
machine LoadPlatformDescription @platforms/boards/stm32h7_renode_reference_board.repl

$bin?=@https://dl.antmicro.com/projects/renode/zephyr_rrp-demo.elf-s_8344888-c5f12b2aac7af72f7430894558749a984eb7d94e

showAnalyzer sysbus.usart2

macro reset
"""
    sysbus LoadELF $bin
    cpu EnableZephyrMode
    cpu VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
"""
runMacro $reset
