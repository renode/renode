:name: Cortex-A53
:description: This script runs Linux (with Coreboot and ATF) on a 64-bit ARM Cortex-A53 with Synopsys PCIe controller driver

$bin?=@https://dl.antmicro.com/projects/renode/designware-pcie-aarch64--coreboot.rom-s_67108864-ab70f03063428242b6bfdc9af5a486042fc3f410
$name?="ARM Cortex-A53 with PCIe"

using sysbus
mach create $name

machine LoadPlatformDescription @platforms/cpus/cortex-a53-gicv3_pcie.repl

showAnalyzer uart0

macro reset
"""
    # Preconfigure UART to see Coreboot and ATF boot logs.
    uart0 WriteDoubleWord 0x30 0x301
    uart0 WriteDoubleWord 0x2c 0x40

    sysbus LoadBinary $bin 0x0

    sysbus LoadSymbolsFrom @https://dl.antmicro.com/projects/renode/designware-pcie-aarch64--coreboot-bootblock.elf-s_48872-58c2160a704f7f7d4c1b26ad8548e51f1e30541a
    sysbus LoadSymbolsFrom @https://dl.antmicro.com/projects/renode/designware-pcie-aarch64--coreboot-romstage.elf-s_65000-4e6b3bf011d1310caceeb4fef0f8bfba8cc24e02
    sysbus LoadSymbolsFrom @https://dl.antmicro.com/projects/renode/designware-pcie-aarch64--coreboot-ramstage.elf-s_193800-5f85fce4ed3467b750e8f7b8c201f68f7d8a457c
    sysbus LoadSymbolsFrom @https://dl.antmicro.com/projects/renode/designware-pcie-aarch64--bl31.elf-s_172568-89ee499d8c285d49323bc886d0a14bcc94844de0
    sysbus LoadSymbolsFrom @https://dl.antmicro.com/projects/renode/designware-pcie-aarch64--vmlinux-s_201249328-0dd0c0a8fe98a58b31bdbd327b611d181ab2ebe1
"""
runMacro $reset
